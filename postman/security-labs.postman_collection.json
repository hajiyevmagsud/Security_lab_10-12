{
  "info": {
    "name": "Security Labs Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "baseUrlAlt", "value": "http://127.0.0.1:3000" },
    { "key": "password", "value": "Str0ng!Pass1" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "Admin@123456" },
    { "key": "userAEmail", "value": "" },
    { "key": "userAUsername", "value": "" },
    { "key": "userBEmail", "value": "" },
    { "key": "userBUsername", "value": "" },
    { "key": "noteId", "value": "" },
    { "key": "userAAccessToken", "value": "" },
    { "key": "userARefreshToken", "value": "" },
    { "key": "userARefreshTokenOld", "value": "" }
  ],
  "item": [
    {
      "name": "Health - Security Headers",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('security headers present (where applicable)', function () {",
              "  pm.expect(pm.response.headers.has('x-content-type-options')).to.be.true;",
              "  pm.expect(pm.response.headers.has('x-frame-options')).to.be.true;",
              "  pm.expect(pm.response.headers.has('content-security-policy')).to.be.true;",
              "  pm.expect(pm.response.headers.has('referrer-policy')).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Register User A (localhost)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now();",
              "pm.collectionVariables.set('userAEmail', `usera+${suffix}@example.com`);",
              "pm.collectionVariables.set('userAUsername', `usera${suffix}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const cookies = pm.response.headers.getAll('set-cookie') || [];",
              "let accessToken = '';",
              "let refreshToken = '';",
              "cookies.forEach((c) => {",
              "  if (c.startsWith('jwt=')) accessToken = c.split(';')[0].split('=')[1];",
              "  if (c.startsWith('refreshToken=')) refreshToken = c.split(';')[0].split('=')[1];",
              "});",
              "if (accessToken) pm.collectionVariables.set('userAAccessToken', accessToken);",
              "if (refreshToken) pm.collectionVariables.set('userARefreshToken', refreshToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userAEmail}}\",\n  \"username\": \"{{userAUsername}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      }
    },
    {
      "name": "Auth - Register Invalid Input",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"bad-email\",\n  \"username\": \"ab\",\n  \"password\": \"weakpass\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', function () {",
              "  pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Login User A (localhost)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userAEmail}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const cookies = pm.response.headers.getAll('set-cookie') || [];",
