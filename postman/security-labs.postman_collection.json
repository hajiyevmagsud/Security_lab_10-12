      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('userARefreshTokenOld', pm.collectionVariables.get('userARefreshToken') || '');",
              "const cookies = pm.response.headers.getAll('set-cookie') || [];",
              "let refreshToken = '';",
              "cookies.forEach((c) => {",
              "  if (c.startsWith('refreshToken=')) refreshToken = c.split(';')[0].split('=')[1];",
              "});",
              "if (refreshToken) pm.collectionVariables.set('userARefreshToken', refreshToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Refresh Token reuse (should fail)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "refreshToken={{userARefreshTokenOld}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/refresh-token"
      },
      "event": [
        {
          "listen": "test",
          "script": {
